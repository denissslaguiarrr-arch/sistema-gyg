# Copiá este archivo a ".env" en la raíz del proyecto y completá los valores.
# No lo subas a Git (ya está en .gitignore).

# Gist del catálogo web (Blogger)
GYG_GIST_ID=74837d1c1f0a9a3a67e6dc5cc4fa5b6f

# Token de GitHub con permiso "gist" únicamente
# https://github.com/settings/tokens/new
GYG_GITHUB_TOKEN=ghp_pegá_tu_token

# Client-ID de Imgur (Anonymous usage, sin callback)
# https://api.imgur.com/oauth2/addclient
GYG_IMGUR_CLIENT_ID=TU_CLIENT_ID
