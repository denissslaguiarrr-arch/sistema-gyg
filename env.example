# Copiá este archivo a ".env" en la raíz del proyecto y completá los valores.
# No lo subas a Git (ya está en .gitignore).

# Gist del catálogo web (Blogger). También se puede pegar en
# Configuración del sitio.
# GYG_GIST_ID=

# Token de GitHub con permiso "gist" únicamente.
# NO lo pongas acá: pegalo en Configuración del sitio. Si este archivo tiene
# un valor de ejemplo (ghp_pegá_tu_token), GitHub rechaza Publicar y parece
# que se cerró la sesión.
# https://github.com/settings/tokens/new?scopes=gist
# GYG_GITHUB_TOKEN=

# Client-ID de Imgur (opcional: Imgur ya no registra apps nuevas)
# GYG_IMGUR_CLIENT_ID=

# Clave de ImgBB para publicar fotos al arrastrarlas (reemplazo de Imgur)
# https://api.imgbb.com/  — también se puede pegar en Configuración del sitio
# GYG_IMGBB_API_KEY=
